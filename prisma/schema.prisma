generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id          String   @id @default(cuid())
  title       String
  type        String
  category    String
  description String
  location    String
  itemDate    DateTime
  imageUrl    String?
  contactEmail String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, status, category])
  @@index([createdAt])
}